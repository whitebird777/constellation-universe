<!-- exploreTest/index.wxml — 宇宙探索试炼 V2 首页融合答题模式 -->
<view class="page-full explore-page" style="padding-top:{{statusBarHeight}}px;">

  <!-- 星空背景 -->
  <view class="explore-bg">
    <view class="explore-nebula explore-nebula--top"></view>
    <view class="explore-nebula explore-nebula--mid"></view>
    <view class="explore-stars"></view>
  </view>

  <!-- 返回 -->
  <view class="nav-back" style="top:{{statusBarHeight}}px;" bindtap="onBack">← 返回</view>

  <!-- ========== 未创建星球 ========== -->
  <block wx:if="{{noPlanet}}">
    <view style="width:560rpx;margin-top:200rpx;text-align:center;padding:40rpx 22rpx;">
      <view style="font-size:48rpx;margin-bottom:16rpx;">🌌</view>
      <view style="font-size:26rpx;color:rgba(255,255,255,0.55);margin-bottom:24rpx;">请先创建星球</view>
      <button class="btn-primary" style="width:400rpx;height:80rpx;" bindtap="onCreatePlanet">创建我的星球</button>
    </view>
  </block>

  <!-- ========== 已完成（今日已挑战）========== -->
  <block wx:if="{{!noPlanet && todayCompleted && phase !== 'result'}}">
    <view class="text-title" style="margin-top:160rpx;">探索完成！</view>
    <view class="explore-subtitle">今日探索任务已经完成</view>

    <view class="glass-card" style="width:560rpx;margin-top:60rpx;padding:44rpx 40rpx;text-align:center;">
      <view style="font-size:80rpx;">🌙</view>
      <view style="font-size:28rpx;color:rgba(255,255,255,0.55);margin-top:24rpx;letter-spacing:3rpx;line-height:1.7;">
        继续积累星光，<br/>明天继续探索新的知识。
      </view>
    </view>

    <view style="margin-top:40rpx;display:flex;justify-content:center;">
      <button class="btn-primary" style="width:400rpx;height:84rpx;font-size:26rpx;" bindtap="onBack">🌙 明日再战</button>
    </view>
  </block>

  <!-- ========== 准备 / 答题中（同一布局）========== -->
  <block wx:if="{{!noPlanet && !todayCompleted && phase !== 'result'}}">

    <!-- 标题 -->
    <view class="text-title" style="margin-top:64rpx;margin-bottom:8rpx;">🚀 宇宙探索试炼</view>
    <view class="explore-subtitle">探索未知知识，收集属于你的星光</view>

    <!-- 挑战信息卡 -->
    <view class="glass-card challenge-info-card">
      <view class="challenge-header">
        <view class="challenge-title">✨ 今日探索挑战</view>
        <view class="challenge-countdown {{phase === 'started' && countdown <= 10 ? 'countdown-urgent' : ''}}">
          {{phase === 'ready' ? '⏳ ' + countdownDisplay + 's' : '⏱ ' + countdownDisplay + 's'}}
        </view>
      </view>
      <view class="challenge-progress">
        <view class="quiz-progress-wrap" style="width:100%;">
          <view class="quiz-progress-bar" style="flex:1;">
            <view class="quiz-progress-fill" style="width:{{(currentIndex + 1) / totalQuestions * 100}}%;"></view>
          </view>
          <view class="quiz-progress-text">第 {{currentIndex + 1}} / {{totalQuestions}} 题</view>
        </view>
      </view>
    </view>

    <!-- 题目卡片 -->
    <view class="glass-card quiz-card">
      <view class="quiz-question-number">第 {{currentIndex + 1}} 题</view>
      <view class="quiz-question-text">{{questions[currentIndex].question}}</view>

      <!-- 选项列表 -->
      <view class="quiz-options">
        <view
          wx:for="{{questions[currentIndex].options}}"
          wx:key="*this"
          wx:for-index="optIdx"
          class="quiz-option {{phase === 'ready' ? 'option-disabled' : ''}} {{phase === 'started' && !answered && selectedOption === optIdx ? 'option-selected' : ''}} {{answered && optIdx === questions[currentIndex].answer ? 'option-correct' : ''}} {{answered && selectedOption === optIdx && optIdx !== questions[currentIndex].answer ? 'option-wrong' : ''}}"
          data-index="{{optIdx}}"
          bindtap="onSelectOption"
        >
          <view class="option-marker">{{optIdx === 0 ? 'A' : optIdx === 1 ? 'B' : optIdx === 2 ? 'C' : 'D'}}</view>
          <view class="option-text">{{item}}</view>
          <view wx:if="{{answered && optIdx === questions[currentIndex].answer}}" class="option-icon-correct">✓</view>
          <view wx:if="{{answered && selectedOption === optIdx && optIdx !== questions[currentIndex].answer}}" class="option-icon-wrong">✗</view>
        </view>
      </view>

      <!-- 解析（作答后显示） -->
      <view wx:if="{{answered}}" class="quiz-explain">
        <view class="explain-icon">{{selectedOption === questions[currentIndex].answer ? '🎉' : '💡'}}</view>
        <view class="explain-text">{{questions[currentIndex].explain}}</view>
      </view>
    </view>

    <!-- 操作按钮区 -->
    <view class="quiz-actions">
      <!-- ready：开始探索按钮 -->
      <button
        wx:if="{{phase === 'ready'}}"
        class="btn-primary"
        style="width:400rpx;height:84rpx;font-size:28rpx;"
        bindtap="onStartExplore"
      >🚀 开始探索</button>

      <!-- started 未作答：确认答案 -->
      <button
        wx:if="{{phase === 'started' && !answered}}"
        class="btn-primary {{selectedOption === null ? 'btn-disabled' : ''}}"
        style="width:400rpx;height:84rpx;font-size:28rpx;"
        bindtap="onSubmitAnswer"
      >确认答案</button>

      <!-- started 已作答：下一题 -->
      <button
        wx:if="{{phase === 'started' && answered}}"
        class="btn-primary"
        style="width:400rpx;height:84rpx;font-size:28rpx;"
        bindtap="onNextQuestion"
      >{{currentIndex + 1 >= totalQuestions ? '查看结果' : '下一题 →'}}</button>
    </view>

  </block>

  <!-- ========== 结算页 ========== -->
  <block wx:if="{{phase === 'result'}}">
    <view class="text-title" style="margin-top:80rpx;">探索完成！</view>
    <view class="explore-subtitle" style="margin-bottom:0;">你已完成本轮试炼挑战</view>

    <view class="glass-card" style="width:560rpx;margin-top:50rpx;padding:44rpx 40rpx;text-align:center;">
      <view style="font-size:80rpx;">{{correctCount >= totalQuestions ? '🏆' : correctCount >= totalQuestions - 1 ? '🌟' : '🚀'}}</view>
      <view style="font-size:64rpx;font-weight:700;color:rgba(200,180,255,0.9);margin-top:20rpx;letter-spacing:4rpx;">
        {{correctCount}}<text style="font-size:32rpx;color:rgba(255,255,255,0.4);"> / {{totalQuestions}}</text>
      </view>
      <view style="font-size:24rpx;color:rgba(255,255,255,0.45);margin-top:12rpx;">
        {{correctCount === totalQuestions ? '完美通关！你是星座知识达人！' : correctCount >= totalQuestions - 1 ? '非常优秀！继续加油！' : correctCount >= totalQuestions - 2 ? '表现不错！再接再厉！' : '继续探索，积累更多知识！'}}
      </view>

      <!-- 星光奖励 -->
      <view wx:if="{{reward > 0}}" style="margin-top:24rpx;padding:18rpx 0;border-top:1rpx solid rgba(255,255,255,0.06);">
        <view style="font-size:22rpx;color:rgba(255,255,255,0.35);letter-spacing:2rpx;margin-bottom:6rpx;">获得奖励</view>
        <view style="font-size:40rpx;font-weight:700;color:rgba(255,215,100,0.9);letter-spacing:3rpx;">✨ +{{reward}} 星光</view>
      </view>
      <view wx:elif="{{todayClaimed}}" style="margin-top:24rpx;padding:18rpx 0;border-top:1rpx solid rgba(255,255,255,0.06);">
        <view style="font-size:20rpx;color:rgba(255,255,255,0.28);">今日奖励已领取</view>
      </view>
    </view>

    <view style="margin-top:40rpx;display:flex;justify-content:center;">
      <button class="btn-primary" style="width:400rpx;height:84rpx;font-size:26rpx;" bindtap="onBack">🌙 明日再战</button>
    </view>
  </block>

</view>
