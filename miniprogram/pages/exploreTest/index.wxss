/** exploreTest/index.wxss — 宇宙探索试炼 V2 **/

.explore-page {
  position: relative;
  min-height: 100vh;
  background: radial-gradient(ellipse at 50% 30%, #0E1648 0%, #090F35 45%, #03081A 100%);
  overflow: hidden;
}

/* ── 星空背景 ── */
.explore-bg {
  position: fixed; top: 0; left: 0;
  width: 100%; height: 100vh;
  pointer-events: none; z-index: 0;
  overflow: hidden;
}
.explore-nebula {
  position: absolute; border-radius: 50%;
}
.explore-nebula--top {
  top: 5%; left: -20%;
  width: 70%; height: 45%;
  background: radial-gradient(ellipse, rgba(100,75,200,0.10) 0%, transparent 60%);
}
.explore-nebula--mid {
  top: 40%; right: -25%;
  width: 65%; height: 50%;
  background: radial-gradient(ellipse, rgba(55,95,180,0.08) 0%, transparent 60%);
}
.explore-stars {
  position: absolute; top: 0; left: 0;
  width: 100%; height: 100%;
  background-image:
    radial-gradient(1rpx 1rpx at 15% 25%, rgba(255,255,255,0.6), transparent),
    radial-gradient(2rpx 2rpx at 72% 18%, rgba(255,255,255,0.5), transparent),
    radial-gradient(1rpx 1rpx at 88% 55%, rgba(200,210,255,0.6), transparent),
    radial-gradient(2rpx 2rpx at 38% 62%, rgba(255,255,255,0.45), transparent),
    radial-gradient(1rpx 1rpx at 55% 78%, rgba(200,210,255,0.5), transparent),
    radial-gradient(1rpx 1rpx at 8% 70%, rgba(255,255,255,0.4), transparent),
    radial-gradient(2rpx 2rpx at 65% 35%, rgba(200,210,255,0.55), transparent),
    radial-gradient(1rpx 1rpx at 28% 42%, rgba(255,255,255,0.35), transparent),
    radial-gradient(1rpx 1rpx at 92% 12%, rgba(200,210,255,0.5), transparent),
    radial-gradient(2rpx 2rpx at 45% 88%, rgba(255,255,255,0.4), transparent);
}

/* ── 副标题 ── */
.explore-subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.36);
  text-align: center;
  letter-spacing: 4rpx;
  margin-top: 8rpx;
}

/* ── 挑战信息卡 ── */
.challenge-info-card {
  width: 560rpx;
  margin-top: 28rpx;
  padding: 24rpx 28rpx !important;
  box-sizing: border-box;
}
.challenge-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.challenge-title {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(220,210,255,0.78);
  letter-spacing: 3rpx;
}
.challenge-countdown {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(180,200,230,0.75);
  letter-spacing: 2rpx;
}
.challenge-countdown.countdown-urgent {
  color: rgba(255,160,140,0.9);
  animation: countdownPulse 0.6s ease-in-out infinite alternate;
}
@keyframes countdownPulse {
  from { transform: scale(1); }
  to   { transform: scale(1.05); }
}
.challenge-progress {
  margin-top: 18rpx;
}

/* ── 答题进度条 ── */
.quiz-progress-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.quiz-progress-bar {
  flex: 1;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255,255,255,0.08);
  overflow: hidden;
}
.quiz-progress-fill {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #5B6EF5, #A855F7);
  transition: width 0.35s ease;
}
.quiz-progress-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  letter-spacing: 2rpx;
  white-space: nowrap;
}

/* ── 题目卡片 ── */
.quiz-card {
  width: 560rpx;
  margin-top: 20rpx;
  padding: 36rpx 32rpx !important;
  box-sizing: border-box;
}
.quiz-question-number {
  font-size: 20rpx;
  color: rgba(180,160,240,0.55);
  letter-spacing: 3rpx;
  margin-bottom: 16rpx;
}
.quiz-question-text {
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.85);
  line-height: 1.6;
  letter-spacing: 2rpx;
  margin-bottom: 28rpx;
}

/* ── 选项列表 ── */
.quiz-options {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.quiz-option {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(140,160,240,0.15);
  background: rgba(100,130,220,0.06);
  transition: all 0.15s ease;
}
.quiz-option:active {
  background: rgba(100,130,220,0.12);
}

/* 未开始：选项不可点击 */
.option-disabled {
  opacity: 0.45;
  pointer-events: none;
}

/* 选中态 */
.option-selected {
  border-color: rgba(160,150,230,0.5);
  background: rgba(130,120,210,0.18);
  box-shadow: 0 0 16rpx rgba(130,110,220,0.18);
}

/* 正确态 */
.option-correct {
  border-color: rgba(100,200,140,0.4);
  background: rgba(80,180,120,0.12);
  box-shadow: 0 0 12rpx rgba(80,180,120,0.12);
}

/* 错误态 */
.option-wrong {
  border-color: rgba(220,100,100,0.4);
  background: rgba(200,90,90,0.12);
  box-shadow: 0 0 12rpx rgba(200,90,90,0.12);
}

.option-marker {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(180,170,230,0.7);
  background: rgba(120,110,200,0.15);
  margin-right: 16rpx;
  flex-shrink: 0;
}
.option-selected .option-marker {
  color: rgba(200,190,255,0.9);
  background: rgba(140,120,230,0.3);
}
.option-correct .option-marker {
  color: rgba(140,240,180,0.9);
  background: rgba(80,180,120,0.25);
}
.option-wrong .option-marker {
  color: rgba(240,130,130,0.9);
  background: rgba(200,90,90,0.25);
}

.option-text {
  flex: 1;
  font-size: 26rpx;
  color: rgba(255,255,255,0.72);
  line-height: 1.4;
}
.option-icon-correct {
  font-size: 28rpx;
  color: rgba(120,220,160,0.8);
  margin-left: 10rpx;
  flex-shrink: 0;
}
.option-icon-wrong {
  font-size: 28rpx;
  color: rgba(220,120,120,0.8);
  margin-left: 10rpx;
  flex-shrink: 0;
}

/* ── 解析区 ── */
.quiz-explain {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  background: rgba(120,100,200,0.08);
  border: 1rpx solid rgba(140,120,220,0.12);
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.explain-icon {
  font-size: 28rpx;
  flex-shrink: 0;
  line-height: 1.4;
}
.explain-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.48);
  line-height: 1.7;
  letter-spacing: 1rpx;
}

/* ── 操作按钮区 ── */
.quiz-actions {
  margin-top: 36rpx;
  display: flex;
  justify-content: center;
}
