<!-- ranking.wxml -->
<view class="page-full rank-page" style="padding-top:{{statusBarHeight}}px;">

  <view class="rank-bg">
    <view class="bg-galaxy"></view>
    <view class="bg-nebula bg-nebula-L"></view>
    <view class="bg-nebula bg-nebula-R"></view>
    <view wx:for="{{stars}}" wx:key="i" class="bg-star" style="{{item.s}}"></view>
    <view wx:for="{{dust}}" wx:key="i" class="bg-dust" style="{{item.s}}"></view>
    <view class="bg-meteor"></view>
  </view>

  <view class="nav-back" style="top:{{statusBarHeight}}px;" bindtap="onBack">← 返回</view>

  <!-- Header -->
  <view style="text-align:center;padding:60rpx 40rpx 0;">
    <view class="text-hero" style="font-size:36rpx;">⭐ 星座荣耀榜 ⭐</view>
  </view>

  <!-- Tab Bar -->
  <view style="display:flex;justify-content:center;gap:16rpx;padding:18rpx 40rpx;">
    <view class="tab-chip {{tab==='constellation'?'tab-active':''}}" bindtap="switchTab" data-tab="constellation">
      <view class="tab-text">星座榜</view>
    </view>
    <view class="tab-chip {{tab==='personal'?'tab-active':''}}" bindtap="switchTab" data-tab="personal">
      <view class="tab-text">个人榜</view>
    </view>
  </view>

  <!-- Constellation Tab -->
  <scroll-view wx:if="{{tab==='constellation'}}" scroll-y style="flex:1;width:100%;padding:0 40rpx 40rpx;">
    <view wx:for="{{constellations}}" wx:key="id" class="const-card">
      <view class="const-rank">
        <view wx:if="{{item.rank===1}}" class="rank-crown crown-gold">👑</view>
        <view wx:elif="{{item.rank===2}}" class="rank-crown crown-silver">👑</view>
        <view wx:elif="{{item.rank===3}}" class="rank-crown crown-bronze">👑</view>
        <view wx:else class="rank-num">{{item.rank}}</view>
      </view>
      <view class="const-info">
        <view class="const-icon">{{item.icon}}</view>
        <view class="const-detail">
          <view class="const-name">{{item.name}}</view>
        </view>
      </view>
      <view class="const-stats">
        <view class="const-residents">{{item.userCount}} 人</view>
        <view class="const-starlight">{{item.starlight}} 星光</view>
      </view>
    </view>
  </scroll-view>

  <!-- Personal Tab -->
  <scroll-view wx:if="{{tab==='personal'}}" scroll-y style="flex:1;width:100%;padding:0 40rpx 40rpx;">
    <!-- 固定 Top10 列表 -->
    <view wx:for="{{personal}}" wx:key="rank" class="const-card">
      <view class="const-rank">
        <view wx:if="{{item.rank===1}}" class="rank-medal medal-gold">🥇</view>
        <view wx:elif="{{item.rank===2}}" class="rank-medal medal-silver">🥈</view>
        <view wx:elif="{{item.rank===3}}" class="rank-medal medal-bronze">🥉</view>
        <view wx:else class="rank-num">{{item.rank}}</view>
      </view>
      <view class="const-info">
        <image wx:if="{{item.avatar}}" src="{{item.avatar}}" style="width:56rpx;height:56rpx;border-radius:50%;margin-right:14rpx;" />
        <view wx:else style="font-size:36rpx;margin-right:14rpx;">🌌</view>
        <view class="const-detail">
          <view class="const-name">{{item.nickname}}</view>
          <view style="font-size:20rpx;color:rgba(255,255,255,0.3);">{{item.constellation}}</view>
        </view>
      </view>
      <view class="const-stats">
        <view class="const-starlight">{{item.starlight}} 星光</view>
      </view>
    </view>

    <!-- 我的排名卡片 -->
    <view wx:if="{{myRank.rank>0}}" style="margin-top:48rpx;">
      <view style="height:1rpx;background:rgba(255,255,255,0.06);margin-bottom:20rpx;"></view>
      <view class="glass-card" style="text-align:center;padding:32rpx;background:rgba(120,100,200,0.06);border-color:rgba(140,120,220,0.12);">
        <view style="font-size:22rpx;color:rgba(255,255,255,0.4);">🏆 我的排名</view>
        <view wx:if="{{myRank.rank===1}}" style="font-size:32rpx;font-weight:700;color:rgba(240,210,100,0.95);margin-top:8rpx;">银河第一名</view>
        <view wx:else style="font-size:32rpx;font-weight:700;color:rgba(160,180,240,0.9);margin-top:8rpx;">第 {{myRank.rank}} 名</view>
        <view style="font-size:24rpx;color:rgba(255,255,255,0.5);margin-top:6rpx;">累计 {{myRank.starlight}} 星光</view>
        <view wx:if="{{myRank.rank===1}}" style="font-size:20rpx;color:rgba(240,210,100,0.5);margin-top:4rpx;">领先所有银河居民</view>
        <view wx:else style="font-size:20rpx;color:rgba(255,255,255,0.3);margin-top:4rpx;">超过 {{myRank.percent}}% 银河居民</view>
      </view>
    </view>
  </scroll-view>

</view>
