/**birthday.wxss V3 **/
.birthday-page { justify-content: flex-start; padding-top: 40rpx; }
.picker-display { display:flex; align-items:center; width:100%; height:80rpx; padding:0 24rpx; border-radius:20rpx; box-sizing:border-box; }
.picker-empty { background:rgba(255,255,255,0.03); border:1rpx solid rgba(255,255,255,0.06); }
.picker-selected { background:rgba(255,255,255,0.06); border:1rpx solid rgba(140,160,240,0.2); }
.picker-label { font-size:24rpx; color:rgba(255,255,255,0.3); margin-right:16rpx; }
.picker-value { flex:1; font-size:28rpx; color:rgba(255,255,255,0.8); }
.picker-empty .picker-value { color:rgba(255,255,255,0.2); }
.picker-arrow { font-size:28rpx; color:rgba(255,255,255,0.2); }
