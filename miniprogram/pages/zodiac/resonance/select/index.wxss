/**
 * select.wxss — 星座标签选择页
 */

/* ═══ 根 ═══ */
.sel-root {
  width: 750rpx; min-height: 100vh; position: relative; overflow-y: auto;
  background: radial-gradient(ellipse at 50% 25%, #0E1648 0%, #090F35 40%, #03081A 100%);
  display: flex; flex-direction: column; align-items: center;
}

/* ═══ 背景 ═══ */
.sel-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100vh; pointer-events: none; z-index: 0; }
.sel-nebula { position: absolute; border-radius: 50%; }
.sel-nebula-l { top: 5%; left: -35%; width: 85%; height: 55%; background: radial-gradient(ellipse, rgba(100,80,200,0.06) 0%, transparent 65%); }
.sel-nebula-r { top: 40%; right: -30%; width: 75%; height: 50%; background: radial-gradient(ellipse, rgba(55,95,180,0.05) 0%, transparent 65%); }
.sel-star { position: absolute; border-radius: 50%; background: #fff; }

/* ═══ 返回 ═══ */
.sel-back {
  position: absolute; left: 28rpx; z-index: 50; top: 0;
  font-size: 26rpx; color: rgba(255,255,255,0.55);
  padding: 10rpx 20rpx; background: rgba(0,0,0,0.25); border-radius: 30rpx;
}

/* ═══ 星座顶部 ═══ */
.sel-hero {
  display: flex; align-items: center; justify-content: center;
  margin-top: 50rpx; position: relative; z-index: 2;
}
.sel-hero-glow {
  position: absolute; width: 180rpx; height: 180rpx; border-radius: 50%;
  animation: heroPulse 4s ease-in-out infinite alternate;
}
@keyframes heroPulse {
  from { opacity: 0.5; transform: scale(0.9); }
  to   { opacity: 1; transform: scale(1.08); }
}
.sel-hero-symbol {
  position: relative; z-index: 2;
  font-size: 80rpx; line-height: 1;
}
.sel-header { text-align: center; margin-top: 12rpx; position: relative; z-index: 2; }
.sel-name  { font-size: 32rpx; font-weight: 700; color: rgba(255,255,255,0.9); letter-spacing: 6rpx; }
.sel-label { font-size: 20rpx; color: rgba(200,180,240,0.45); margin-top: 4rpx; letter-spacing: 3rpx; }

/* ═══ 已选计数 ═══ */
.sel-count { text-align: center; margin-top: 28rpx; position: relative; z-index: 2; }
.sel-count-text { font-size: 24rpx; color: rgba(255,255,255,0.5); }
.sel-count-num  { color: rgba(230,210,120,0.9); font-weight: 700; }
.sel-count-prompt { font-size: 20rpx; color: rgba(255,255,255,0.3); margin-top: 6rpx; }

/* ═══ 标签分组 ═══ */
.sel-group { width: 640rpx; margin-top: 28rpx; position: relative; z-index: 2; }
.sel-group-title { font-size: 20rpx; color: rgba(200,210,255,0.4); letter-spacing: 3rpx; margin-bottom: 14rpx; text-align: center; }
.sel-tag-row { display: flex; flex-wrap: wrap; gap: 12rpx; justify-content: center; }

/* ─ 单个标签 ─ */
.sel-tag {
  padding: 16rpx 30rpx; border-radius: 34rpx;
  font-size: 24rpx; color: rgba(200,210,255,0.7);
  background: rgba(100,125,225,0.06);
  border: 1rpx solid rgba(140,160,240,0.14);
  transition: all 0.2s;
}
.sel-tag-on {
  color: rgba(255,230,160,0.95);
  background: rgba(200,170,80,0.12);
  border: 1rpx solid rgba(220,190,100,0.3);
  box-shadow: 0 0 20rpx rgba(200,160,60,0.15), inset 0 0 12rpx rgba(200,160,60,0.06);
}

/* ═══ 提交按钮 ═══ */
.sel-submit {
  width: 560rpx; height: 88rpx; margin-top: 44rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 44rpx;
  font-size: 28rpx; font-weight: 600; letter-spacing: 4rpx;
  color: rgba(220,215,255,0.9);
  background: linear-gradient(135deg, rgba(100,140,255,0.25), rgba(140,100,240,0.2));
  border: 1rpx solid rgba(140,160,240,0.2);
  position: relative; z-index: 2;
}
.sel-submit:active { opacity: 0.8; }
.sel-submit-disabled {
  opacity: 0.35;
  pointer-events: none;
}

/* ═══ 底部 ═══ */
.sel-spacer { height: 60rpx; }
