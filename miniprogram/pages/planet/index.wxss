/**
 * planet.wxss — 我的星球 V2.2
 */

.planet-page { justify-content: flex-start; padding-top: 0; }

/* ── 导航 ── */
.nav-back {
  position: fixed; left: 28rpx; z-index: 50;
  font-size: 26rpx; color: rgba(255,255,255,0.55);
  padding: 10rpx 20rpx;
  background: rgba(0,0,0,0.25);
  border-radius: 30rpx;
}

/* ── 卡片 ── */
.glass-card {
  background: rgba(100,125,225,0.06);
  border: 1rpx solid rgba(140,160,240,0.12);
  border-radius: 24rpx;
  box-shadow: 0 0 30rpx rgba(80,115,255,0.04);
}
.card-base {
  width: 600rpx; margin: 0 auto 18rpx; padding: 30rpx 28rpx;
}
.card-label {
  font-size: 18rpx; color: rgba(200,210,255,0.4);
  letter-spacing: 4rpx; text-align: center; margin-bottom: 20rpx;
}

/* ── 星球主体（紧凑） ── */
.planet-hero {
  display: flex; flex-direction: column; align-items: center;
  margin: 40rpx 0 20rpx; position: relative;
}
.planet-hero-glow {
  position: absolute; width: 260rpx; height: 260rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(96,122,255,0.12) 0%, rgba(70,90,210,0.03) 50%, transparent 70%);
  animation: heroGlow 5s ease-in-out infinite alternate;
}
@keyframes heroGlow {
  from { opacity: 0.5; transform: scale(0.92); }
  to   { opacity: 1;   transform: scale(1.06); }
}
.planet-hero-core {
  position: relative; z-index: 2;
  display: flex; align-items: center; justify-content: center;
}
.planet-body {
  width: 160rpx; height: 160rpx; border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, rgba(90,130,255,0.75) 0%, rgba(35,55,150,0.85) 40%, rgba(10,20,70,0.95) 100%);
  box-shadow: 0 0 30rpx rgba(80,130,255,0.45), 0 0 70rpx rgba(50,100,255,0.2);
  display: flex; align-items: center; justify-content: center; font-size: 80rpx;
  position: relative; z-index: 2;
  animation: corePulse 4s ease-in-out infinite alternate;
}
@keyframes corePulse {
  from { box-shadow: 0 0 25rpx rgba(80,130,255,0.35), 0 0 55rpx rgba(50,100,255,0.15); }
  to   { box-shadow: 0 0 40rpx rgba(80,130,255,0.55), 0 0 85rpx rgba(50,100,255,0.28); }
}
.planet-hero-rings {
  display: flex; gap: 8rpx; margin-top: 10rpx;
}
.planet-ring-item {
  font-size: 24rpx; opacity: 0.65;
  animation: ringFloat 3s ease-in-out infinite alternate;
}
.planet-ring-item:nth-child(odd) { animation-delay: 0.4s; }
@keyframes ringFloat {
  from { transform: translateY(0); opacity: 0.5; }
  to   { transform: translateY(-6rpx); opacity: 0.8; }
}

/* ── 星球档案 ═══ */
.arch-card { padding-top: 32rpx; padding-bottom: 28rpx; }
.arch-top {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
}
.arch-const-icon { font-size: 44rpx; }
.arch-const-name { font-size: 30rpx; font-weight: 700; color: #fff; }
.arch-stage-tag {
  padding: 5rpx 20rpx; border-radius: 24rpx;
  border: 1rpx solid rgba(140,160,240,0.18);
  background: rgba(120,145,220,0.06);
  font-size: 20rpx; color: rgba(180,200,255,0.7);
}
.arch-age-row {
  text-align: center; margin-top: 14rpx;
  font-size: 22rpx; color: rgba(255,255,255,0.45);
}
.arch-nums {
  display: flex; justify-content: center; gap: 40rpx; margin-top: 20rpx;
}
.arch-num { display: flex; align-items: center; gap: 8rpx; }
.arch-num-val { font-size: 26rpx; font-weight: 700; }
.arch-num-val.gold { color: rgba(240,210,110,0.95); }
.arch-num-val.blue { color: rgba(160,180,255,0.9); }
.arch-num-lab { font-size: 18rpx; color: rgba(255,255,255,0.3); }

/* ── 生命树 ── */
.tree-card { padding-top: 32rpx; padding-bottom: 28rpx; }
.tree-icon-place {
  font-size: 48rpx; text-align: center; margin-bottom: 14rpx;
}
.tree-stage-row {
  text-align: center; margin-bottom: 2rpx;
}
.tree-stage { font-size: 28rpx; font-weight: 600; color: rgba(180,210,180,0.9); }
.tree-lv { font-size: 20rpx; color: rgba(180,210,180,0.45); margin-left: 8rpx; font-weight: 400; }
.tree-bar {
  width: 100%; height: 8rpx; background: rgba(255,255,255,0.05); border-radius: 5rpx;
  margin-top: 16rpx; overflow: hidden;
}
.tree-bar-fill {
  height: 100%; background: linear-gradient(90deg, #34D399, #10B981); border-radius: 5rpx;
  transition: width 0.8s ease;
}
.tree-next-row {
  font-size: 20rpx; color: rgba(255,255,255,0.28);
  text-align: center; margin-top: 12rpx;
}

/* ── 星光花园 ── */
.garden-body { display: flex; gap: 20rpx; }
.garden-icon { font-size: 64rpx; line-height: 1; width: 80rpx; text-align: center; flex-shrink: 0; }
.garden-info { flex: 1; }
.garden-name { font-size: 24rpx; font-weight: 600; color: rgba(255,255,255,0.9); }
.garden-hint { font-size: 20rpx; color: rgba(255,255,255,0.4); margin-top: 2rpx; }
.garden-bar {
  width: 100%; height: 6rpx; background: rgba(255,255,255,0.05); border-radius: 3rpx;
  margin-top: 10rpx; overflow: hidden;
}
.garden-bar-fill {
  height: 100%; background: linear-gradient(90deg, #5B6EF5, #A855F7); border-radius: 3rpx;
}
.garden-meta { display: flex; justify-content: space-between; margin-top: 4rpx; }
.garden-meta-text { font-size: 18rpx; color: rgba(255,255,255,0.22); }
.garden-actions { display: flex; gap: 14rpx; margin-top: 20rpx; }

/* 花园按钮 */
.garden-btn {
  flex: 1; height: 68rpx; border-radius: 36rpx; font-size: 24rpx; font-weight: 500;
  border: none; display: flex; align-items: center; justify-content: center;
}
.garden-btn-water {
  background: rgba(80,150,220,0.1); color: rgba(160,200,240,0.9); border: 1rpx solid rgba(80,150,220,0.18);
}
.garden-btn-water:active { background: rgba(80,150,220,0.18); }
.garden-btn-harvest {
  background: rgba(220,170,60,0.1); color: rgba(240,210,120,0.9); border: 1rpx solid rgba(220,170,60,0.18);
}
.garden-btn-harvest:active { background: rgba(220,170,60,0.2); }
.garden-btn-off {
  background: rgba(255,255,255,0.02); color: rgba(255,255,255,0.18); border: 1rpx solid rgba(255,255,255,0.04);
}

/* ── 星球徽章（横向收藏） ── */
.badge-section { padding-bottom: 20rpx; }
.badge-row { display: flex; gap: 14rpx; }
.badge-cell {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 20rpx 8rpx; border-radius: 16rpx;
  background: rgba(100,125,225,0.04); border: 1rpx solid rgba(140,160,240,0.06);
}
.badge-emoji { font-size: 40rpx; margin-bottom: 8rpx; }
.badge-emoji.on { opacity: 1; }
.badge-emoji.off { opacity: 0.22; filter: grayscale(1); }
.badge-name { font-size: 20rpx; color: rgba(255,255,255,0.6); }
.badge-more {
  text-align: right; margin-top: 14rpx;
  font-size: 20rpx; color: rgba(160,180,240,0.45);
}
.badge-more:active { opacity: 0.7; }

/* ── 底部 ── */
.planet-spacer { height: 80rpx; }

/* ── 星球状态 ── */
.planet-vibe { padding-bottom: 20rpx; }
.vibe-grid { display: flex; gap: 12rpx; }
.vibe-item {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 16rpx 6rpx;
  border-radius: 14rpx;
  background: rgba(100,125,225,0.04);
}
.vibe-icon { font-size: 32rpx; margin-bottom: 8rpx; }
.vibe-text { font-size: 18rpx; color: rgba(255,255,255,0.35); text-align: center; line-height: 1.4; }

/* ── 流星雨 ── */
.shower-meteor {
  position: absolute; height: 120rpx;
  background: linear-gradient(135deg, rgba(200,215,255,0.7) 0%, rgba(180,195,240,0.3) 50%, transparent 100%);
  border-radius: 2rpx; pointer-events: none;
  animation: meteorShower linear infinite; opacity: 0;
}
.shower-bright {
  height: 180rpx;
  background: linear-gradient(135deg, rgba(220,230,255,0.9) 0%, rgba(200,215,250,0.5) 40%, transparent 100%);
}
@keyframes meteorShower {
  0%   { opacity: 0;   transform: translate(0, 0) rotate(-40deg); }
  3%   { opacity: 0.8; transform: translate(-80rpx, 120rpx) rotate(-40deg); }
  8%   { opacity: 0.4; transform: translate(-200rpx, 340rpx) rotate(-40deg); }
  12%  { opacity: 0;   transform: translate(-320rpx, 520rpx) rotate(-40deg); }
  100% { opacity: 0;   transform: translate(-320rpx, 520rpx) rotate(-40deg); }
}
