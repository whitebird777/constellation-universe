<!-- pages/planet/index.wxml V2.2 -->
<view class="page-scroll planet-page" style="padding-top:{{statusBarHeight}}px;">

  <view class="nav-back" style="top:{{statusBarHeight}}px;" bindtap="onGoHome">← 返回</view>

  <view class="universe-atmosphere">
    <view class="atmo-glow" style="top:25%;"></view>
    <view class="atmo-nebula-right" style="top:50%;right:-20%;width:70%;height:50%;background:radial-gradient(ellipse, rgba(80,140,100,0.06) 0%, transparent 70%);"></view>
    <view wx:for="{{stars}}" wx:key="i" class="atmo-star" style="top:{{item.t}};left:{{item.l}};width:{{item.w}};height:{{item.h}};--dur:{{item.d}}s;--delay:{{item.y}}s;"></view>
    <view wx:for="{{dust}}" wx:key="i" class="atmo-dust" style="top:{{item.t}};left:{{item.l}};width:{{item.w}};height:{{item.h}};--dur:{{item.d}}s;--delay:{{item.y}}s;"></view>
    <block wx:for="{{meteors}}" wx:key="id">
      <view wx:if="{{item.visible}}" class="shower-meteor {{item.bright ? 'shower-bright' : ''}}" style="top:{{item.top}}%;left:{{item.left}}%;width:{{item.size}}rpx;animation-duration:{{item.dur}}s;animation-delay:{{item.delay}}s;"></view>
    </block>
  </view>

  <view wx:if="{{loadError}}" style="margin-top:200rpx;text-align:center;color:rgba(255,255,255,0.6);">
    <view>{{loadError}}</view>
  </view>

  <block wx:else>

    <!-- ═══ 星球主体 ═══ -->
    <view class="planet-hero">
      <view class="planet-hero-glow"></view>
      <view class="planet-hero-core" bindtap="onGlobeTap">
        <view class="planet-body">{{appearance.planet}}</view>
      </view>
      <view class="planet-hero-rings">
        <view wx:for="{{appearance.layers}}" wx:key="*this" class="planet-ring-item">{{item}}</view>
      </view>
    </view>

    <view wx:if="{{offlineFeedback}}" style="margin:0 50rpx 8rpx;background:rgba(160,180,255,0.06);border-radius:10rpx;padding:8rpx 20rpx;text-align:center;">
      <view style="font-size:20rpx;color:rgba(255,255,255,0.5);">{{offlineFeedback.message}}</view>
    </view>
    <view wx:elif="{{feedback}}" style="margin:0 50rpx 8rpx;text-align:center;font-size:20rpx;color:rgba(255,255,255,0.5);">{{feedback.icon}} {{feedback.message}}</view>

    <!-- ═══ 星球档案 ═══ -->
    <view class="glass-card card-base arch-card">
      <view class="card-label">🌍 星球档案</view>
      <view class="arch-top">
        <view class="arch-const-icon">{{constellationIcon}}</view>
        <view class="arch-const-name">{{constellation}}</view>
        <view class="arch-stage-tag">{{stage}}</view>
      </view>
      <view class="arch-age-row">守护星球 · 第{{age}}天</view>
      <view class="arch-nums">
        <view class="arch-num">
          <view class="arch-num-val gold">✨ {{personalStarlight}}</view>
          <view class="arch-num-lab">累计星光</view>
        </view>
        <view class="arch-num">
          <view class="arch-num-val blue">{{dailyEarned}}</view>
          <view class="arch-num-lab">今日星光</view>
        </view>
      </view>
    </view>

    <!-- ═══ 生命树 ═══ -->
    <view class="glass-card card-base tree-card">
      <view class="card-label">🌳 生命树</view>
      <view class="tree-icon-place">{{lifeTree.icon}}</view>
      <view class="tree-stage-row">
        <view class="tree-stage">{{lifeTree.currentStage}} <text class="tree-lv">{{lifeTree.currentLevel}}</text></view>
      </view>
      <view class="tree-bar"><view class="tree-bar-fill" style="width:{{lifeTree.progress}};"></view></view>
      <view class="tree-next-row">下一阶段 · {{lifeTree.nextStage}}</view>
    </view>

    <!-- ═══ 星光花园 ═══ -->
    <view class="glass-card card-base" wx:if="{{farmPlot}}">
      <view class="card-label">✨ 星光花园</view>
      <view class="garden-body">
        <view class="garden-icon">{{farmPlot.icon}}</view>
        <view class="garden-info">
          <view class="garden-name">{{farmPlot.title}}</view>
          <view class="garden-hint">{{farmPlot.hint}}</view>
          <view class="garden-bar"><view class="garden-bar-fill" style="width:{{farmPlot.progress}}%;"></view></view>
          <view class="garden-meta">
            <view class="garden-meta-text">生长 {{farmPlot.progressText}}</view>
            <view class="garden-meta-text">💧 {{farmPlot.waterChances}} 次浇灌</view>
          </view>
        </view>
      </view>
      <view class="garden-actions">
        <button wx:if="{{farmPlot.canWater}}" class="garden-btn garden-btn-water" bindtap="onWater">💧 浇灌 +1</button>
        <button wx:else class="garden-btn garden-btn-off">💧 浇灌</button>
        <button wx:if="{{farmPlot.canHarvest}}" class="garden-btn garden-btn-harvest" bindtap="onHarvest">✨ 收获 +5</button>
        <button wx:else class="garden-btn garden-btn-off">✨ 收获</button>
      </view>
    </view>

    <!-- ═══ 星球徽章 ═══ -->
    <view class="glass-card card-base badge-section">
      <view class="card-label">🏆 星球徽章</view>
      <view class="badge-row">
        <view class="badge-cell">
          <view class="badge-emoji on">🌱</view>
          <view class="badge-name">初次萌芽</view>
        </view>
        <view class="badge-cell">
          <view class="badge-emoji off">💧</view>
          <view class="badge-name">七日守护</view>
        </view>
        <view class="badge-cell">
          <view class="badge-emoji off">🌳</view>
          <view class="badge-name">星树成长</view>
        </view>
      </view>
      <view class="badge-more" bindtap="onBadges">
        <text>查看更多徽章 →</text>
      </view>
    </view>

    <!-- ═══ 星球状态 ═══ -->
    <view class="glass-card card-base planet-vibe">
      <view class="card-label">🌌 星球状态</view>
      <view class="vibe-grid">
        <view class="vibe-item">
          <view class="vibe-icon">{{vibe.starlight.icon}}</view>
          <view class="vibe-text">{{vibe.starlight.text}}</view>
        </view>
        <view class="vibe-item">
          <view class="vibe-icon">{{vibe.weather.icon}}</view>
          <view class="vibe-text">{{vibe.weather.text}}</view>
        </view>
        <view class="vibe-item">
          <view class="vibe-icon">{{vibe.visit.icon}}</view>
          <view class="vibe-text">{{vibe.visit.text}}</view>
        </view>
      </view>
    </view>

    <view class="planet-spacer"></view>
  </block>

</view>
