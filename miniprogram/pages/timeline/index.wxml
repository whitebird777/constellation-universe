<!--timeline.wxml V3 -->
<view class="page-full timeline-page" style="padding-top:{{statusBarHeight}}px;">

  <view class="universe-atmosphere">
    <view class="atmo-glow" style="top:15%;width:400rpx;height:400rpx;background:radial-gradient(circle, rgba(180,160,100,0.06) 0%, transparent 60%);"></view>
    <view class="atmo-nebula-left" style="top:30%;left:-20%;width:60%;height:50%;background:radial-gradient(ellipse, rgba(180,160,100,0.04) 0%, transparent 70%);"></view>
    <view wx:for="{{stars}}" wx:key="i" class="atmo-star" style="top:{{item.t}};left:{{item.l}};width:{{item.w}};height:{{item.h}};--dur:{{item.d}}s;--delay:{{item.y}}s;"></view>
    <view wx:for="{{dust}}" wx:key="i" class="atmo-dust" style="top:{{item.t}};left:{{item.l}};width:{{item.w}};height:{{item.h}};--dur:{{item.d}}s;--delay:{{item.y}}s;"></view>
    <view class="atmo-meteor"></view>
    <view class="atmo-meteor-fast"></view>
  </view>

  <view class="nav-back" style="top:{{statusBarHeight}}px;" bindtap="onBack">← 返回</view>

  <view class="text-title" style="margin-top:80rpx;margin-bottom:28rpx;">宇宙日志</view>

  <view wx:if="{{events.length === 0}}" style="text-align:center;margin-top:28vh;">
    <view style="font-size:64rpx;">📖</view>
    <view class="text-body" style="margin-top:16rpx;">还没有记录任何宇宙事件。</view>
    <view class="text-label" style="margin-top:8rpx;">回到星球，一切刚刚开始。</view>
  </view>

  <scroll-view wx:else scroll-y style="flex:1;width:100%;padding:0 40rpx 40rpx;">
    <view wx:for="{{events}}" wx:key="id" style="padding-left:28rpx;border-left:1rpx solid rgba(160,180,255,0.10);padding-bottom:24rpx;position:relative;">
      <view style="position:absolute;left:-5rpx;top:0;width:9rpx;height:9rpx;border-radius:50%;background:rgba(160,180,255,0.4);box-shadow:0 0 10rpx rgba(160,180,255,0.3);"></view>
      <view style="font-size:18rpx;color:rgba(255,255,255,0.2);margin-bottom:8rpx;">{{item.date}}</view>
      <view class="glass-card" style="display:flex;align-items:flex-start;padding:20rpx 24rpx;">
        <view style="font-size:36rpx;margin-right:16rpx;flex-shrink:0;">{{item.icon}}</view>
        <view style="flex:1;">
          <view style="font-size:26rpx;font-weight:600;color:rgba(255,255,255,0.85);margin-bottom:4rpx;">{{item.title}}</view>
          <view style="font-size:22rpx;color:rgba(255,255,255,0.4);line-height:1.5;">{{item.description}}</view>
        </view>
      </view>
    </view>
  </scroll-view>

</view>
