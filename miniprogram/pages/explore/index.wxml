<!--explore.wxml V5 -->
<view class="page-full explore-page" style="padding-top:{{statusBarHeight}}px;">

  <view wx:if="{{noPlanet}}" style="width:560rpx;margin-top:200rpx;text-align:center;padding:40rpx 22rpx;">
    <view style="font-size:48rpx;margin-bottom:16rpx;">🌌</view>
    <view style="font-size:26rpx;color:rgba(255,255,255,0.55);margin-bottom:24rpx;">请先成为星球主人后参与宇宙探索</view>
    <button class="btn-primary" style="width:400rpx;height:80rpx;" bindtap="onCreatePlanet">创建我的星球</button>
  </view>

  <block wx:else>

  <view class="universe-atmosphere">
    <view class="atmo-glow" style="top:35%;width:600rpx;height:600rpx;"></view>
    <view class="atmo-nebula-left" style="top:10%;left:-25%;width:80%;height:60%;background:radial-gradient(ellipse, rgba(120,100,180,0.1) 0%, transparent 70%);"></view>
    <view class="atmo-nebula-right" style="top:40%;right:-20%;width:60%;height:50%;background:radial-gradient(ellipse, rgba(80,120,200,0.08) 0%, transparent 70%);"></view>
    <view wx:for="{{stars}}" wx:key="i" class="atmo-star" style="top:{{item.t}};left:{{item.l}};width:{{item.w}};height:{{item.h}};--dur:{{item.d}}s;--delay:{{item.y}}s;"></view>
    <view wx:for="{{dust}}" wx:key="i" class="atmo-dust" style="top:{{item.t}};left:{{item.l}};width:{{item.w}};height:{{item.h}};--dur:{{item.d}}s;--delay:{{item.y}}s;"></view>
    <view class="atmo-meteor" style="animation-delay:8s;animation-duration:22s;"></view>
    <view class="atmo-meteor-fast" style="animation-delay:2s;animation-duration:14s;"></view>
  </view>

  <view class="nav-back" style="top:{{statusBarHeight}}px;" bindtap="onBack">← 返回</view>

  <view style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;">
    <view style="font-size:130rpx;text-shadow:0 0 80rpx rgba(160,180,255,0.35);line-height:1;animation:glowBreath 5s ease-in-out infinite;">{{icon}}</view>
    <view class="text-title" style="margin-top:24rpx;">{{title}}</view>
    <view class="text-body" style="margin-top:12rpx;max-width:480rpx;">{{description}}</view>
  </view>

  <view style="margin-top:16rpx;padding-bottom:60rpx;">
    <button wx:if="{{!recorded}}" class="btn-primary" bindtap="onRecord">✨ 记录今日探索</button>
    <button wx:else class="btn-disabled">✅ 今日已记录</button>
  </view>

</block>
</view>
