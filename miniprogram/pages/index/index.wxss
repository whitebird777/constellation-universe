/** index.wxss — 星座联盟 · 功能入口大厅 **/

.home {
  height: 100vh; overflow: hidden; position: relative;
  background: radial-gradient(ellipse at 50% 35%, #0E1648 0%, #090F35 40%, #03081A 100%);
}

/* ── 背景层 ── */
.home-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100vh; pointer-events: none; z-index: 0; overflow: hidden; }
.bg-nebula { position: absolute; width: 80%; height: 60%; border-radius: 50%; }
.bg-nebula--L { top: 8%; left: -30%; background: radial-gradient(ellipse, rgba(100,75,200,0.10) 0%, transparent 65%); animation: nDrift 22s ease-in-out infinite alternate; }
.bg-nebula--R { top: 35%; right: -28%; background: radial-gradient(ellipse, rgba(55,95,180,0.08) 0%, transparent 65%); animation: nDrift 26s ease-in-out infinite alternate-reverse; }
@keyframes nDrift { 0% { transform:translate(0,0); } 100% { transform:translate(25rpx,-15rpx); } }
.bg-galaxy { position: absolute; top: 35%; left: 50%; transform: translateX(-50%); width: 600rpx; height: 600rpx; border-radius: 50%; background: radial-gradient(circle, rgba(110,130,230,0.10) 0%, rgba(80,100,200,0.04) 35%, transparent 65%); animation: gBreath 7s ease-in-out infinite alternate; }
@keyframes gBreath { 0% { opacity:0.5; transform:translateX(-50%) scale(0.9); } 100% { opacity:1; transform:translateX(-50%) scale(1.1); } }
.bg-star { position: absolute; border-radius: 50%; background: #fff; }
@keyframes starPulse { 0% { opacity:0.15; transform:scale(0.5); } 50% { opacity:1; transform:scale(1.2); } 100% { opacity:0.25; transform:scale(0.7); } }
.bg-dust { position: absolute; border-radius: 50%; background: rgba(180,200,240,0.35); }
@keyframes dustFloat { 0%{opacity:0;transform:translate(0,0);} 25%{opacity:0.55;transform:translate(12rpx,-25rpx);} 50%{opacity:0.15;transform:translate(-8rpx,-55rpx);} 75%{opacity:0.45;transform:translate(-18rpx,-28rpx);} 100%{opacity:0;transform:translate(0,0);} }

/* ── Canvas 流星层 ── */
.meteor-canvas {
  position: fixed; top: 0; left: 0;
  width: 100%; height: 100vh;
  pointer-events: none; z-index: 5;
}

/* ── 主内容 ── */
.home-main { position: relative; z-index: 10; display: flex; flex-direction: column; align-items: center; height: 100vh; padding: 40rpx 40rpx 0; box-sizing: border-box; }

/* ── 标题 ── */
.home-header { text-align: center; flex-shrink: 0; margin-top: 20rpx; }
.header-title { font-size: 44rpx; font-weight: 600; color: rgba(255,255,255,0.92); letter-spacing: 6rpx; }
.header-sub { font-size: 24rpx; color: rgba(255,255,255,0.4); margin-top: 8rpx; letter-spacing: 2rpx; }

/* ── 首页快捷入口 ── */
.home-quick-row {
  position: relative; z-index: 10;
  display: flex; align-items: center; justify-content: center;
  gap: 16rpx;
  margin-top: 24rpx;
  flex-shrink: 0;
}
.quick-entry {
  display: flex; align-items: center; justify-content: center;
  padding: 13rpx 26rpx;
  border-radius: 60rpx;
  border: 1rpx solid rgba(140,160,240,0.18);
  background: rgba(100,130,220,0.08);
  box-shadow: 0 0 18rpx rgba(80,120,255,0.06);
}
.quick-entry:active { opacity: 0.72; transform: scale(0.97); }
.quick-icon { font-size: 26rpx; margin-right: 8rpx; }
.quick-label { font-size: 23rpx; color: rgba(255,255,255,0.46); letter-spacing: 2rpx; }

/* ── 每日星光打卡卡片 ── */
.checkin-card {
  position: relative; z-index: 10;
  display: flex; align-items: center; justify-content: center;
  margin-top: 14rpx; flex-shrink: 0;
  transform: translateY(10rpx);
  padding: 16rpx 36rpx;
  border-radius: 60rpx;
  border: 1rpx solid rgba(200,175,100,0.28);
  background: linear-gradient(135deg, rgba(180,140,80,0.14), rgba(120,80,180,0.10));
  box-shadow: 0 0 22rpx rgba(180,140,60,0.12), inset 0 0 18rpx rgba(200,170,100,0.06);
  gap: 12rpx;
}
.checkin-card:active {
  opacity: 0.72; transform: scale(0.97);
}
.checkin-done {
  border-color: rgba(140,160,240,0.14);
  background: linear-gradient(135deg, rgba(80,110,160,0.08), rgba(60,70,120,0.06));
  box-shadow: 0 0 14rpx rgba(80,120,255,0.06);
}
.checkin-icon { font-size: 28rpx; }
.checkin-text { font-size: 26rpx; color: rgba(255,240,210,0.88); letter-spacing: 3rpx; }
.checkin-done .checkin-text { color: rgba(255,255,255,0.42); }
.checkin-status {
  font-size: 21rpx;
  color: rgba(220,190,120,0.75);
  letter-spacing: 2rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(200,170,110,0.22);
  background: rgba(180,140,70,0.1);
}
.checkin-done .checkin-status {
  color: rgba(200,200,210,0.4);
  border-color: rgba(140,150,180,0.12);
  background: rgba(100,110,140,0.06);
}

/* ── 打卡成功弹窗 ── */
.checkin-modal-mask {
  position: fixed; top: 0; left: 0; width: 100%; height: 100vh;
  background: rgba(3,8,26,0.72);
  z-index: 900;
}
.checkin-modal {
  position: fixed; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  z-index: 901;
  width: 520rpx;
}
.checkin-modal-bg {
  border-radius: 36rpx;
  border: 1rpx solid rgba(140,160,240,0.2);
  background: linear-gradient(160deg, rgba(25,40,90,0.95), rgba(12,20,50,0.96));
  box-shadow: 0 0 60rpx rgba(80,120,255,0.16), inset 0 0 30rpx rgba(100,130,230,0.06);
  backdrop-filter: blur(20rpx);
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
}
.checkin-modal-content {
  position: relative; z-index: 1;
  display: flex; flex-direction: column; align-items: center;
  padding: 48rpx 40rpx 36rpx;
}
.checkin-modal-icon { font-size: 56rpx; margin-bottom: 16rpx; }
.checkin-modal-title {
  font-size: 38rpx; font-weight: 600;
  color: rgba(255,240,210,0.92);
  letter-spacing: 4rpx;
}
.checkin-modal-reward {
  font-size: 30rpx;
  color: rgba(220,190,120,0.88);
  margin-top: 12rpx;
  letter-spacing: 2rpx;
}
.checkin-modal-divider {
  width: 120rpx; height: 2rpx;
  margin: 24rpx 0;
  background: linear-gradient(to right, transparent, rgba(180,160,130,0.4), transparent);
}
.checkin-modal-quote {
  font-size: 24rpx;
  color: rgba(200,200,220,0.55);
  text-align: center;
  line-height: 1.7;
  letter-spacing: 2rpx;
  padding: 0 16rpx;
}
.checkin-modal-btn {
  margin-top: 32rpx;
  padding: 18rpx 80rpx;
  border-radius: 50rpx;
  border: 1rpx solid rgba(200,170,110,0.3);
  background: linear-gradient(135deg, rgba(180,140,80,0.18), rgba(120,80,180,0.12));
  color: rgba(255,240,210,0.88);
  font-size: 28rpx;
  letter-spacing: 3rpx;
}
.checkin-modal-btn:active {
  opacity: 0.7; transform: scale(0.96);
}

/* ── 深空背景音乐播放器 ── */
.music-player {
  position: relative; z-index: 10;
  display: flex; align-items: center; justify-content: center;
  margin-top: 28rpx;
  flex-shrink: 0;
  transform: translateY(20rpx);
}
.music-btn {
  display: flex; align-items: center; justify-content: center;
  width: 68rpx; height: 68rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(140,160,240,0.25);
  background: rgba(30,45,100,0.35);
  box-shadow: 0 0 20rpx rgba(80,120,255,0.12);
  transition: all 0.3s ease;
}
.music-btn:active { opacity: 0.7; transform: scale(0.92); }
.music-on {
  border-color: rgba(140,160,255,0.4);
  box-shadow: 0 0 28rpx rgba(100,140,255,0.22);
  animation: musicGlow 3s ease-in-out infinite alternate;
}
.music-off {
  border-color: rgba(140,160,240,0.12);
  box-shadow: 0 0 12rpx rgba(80,120,255,0.04);
  opacity: 0.55;
}
@keyframes musicGlow {
  from { box-shadow: 0 0 18rpx rgba(100,140,255,0.14); }
  to   { box-shadow: 0 0 32rpx rgba(120,160,255,0.26); }
}
.music-icon { font-size: 28rpx; line-height: 1; }

/* 音乐滚动文字 */
.music-marquee {
  margin-left: 16rpx;
  overflow: hidden;
  white-space: nowrap;
}
.marquee-text {
  font-size: 22rpx;
  color: rgba(200,210,255,0.5);
  letter-spacing: 3rpx;
  display: inline-block;
  animation: marqueeScroll 14s linear infinite;
}
@keyframes marqueeScroll {
  0%   { transform: translateX(340rpx); }
  100% { transform: translateX(-100%); }
}

/* ── 魔法星空船舵 ── */
.steering-wheel {
  position: relative;
  flex: 1;
  width: 100%;
  min-height: 0;
  max-height: 820rpx;
  margin-top: 10rpx;
  /* 只移动整组船舵，不改变内部按钮比例 */
  transform: translateY(98rpx);
}
.wheel-halo {
  position: absolute; top: 50%; left: 50%;
  width: 380rpx; height: 380rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(96,122,255,0.14) 0%, rgba(70,90,210,0.06) 45%, transparent 72%);
  animation: wheelHalo 4.5s ease-in-out infinite alternate;
}
@keyframes wheelHalo {
  from { opacity: 0.58; transform: translate(-50%, -50%) scale(0.94); }
  to { opacity: 1; transform: translate(-50%, -50%) scale(1.04); }
}
.wheel-ring {
  position: absolute; top: 50%; left: 50%;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
}
.wheel-ring-outer {
  width: 420rpx; height: 420rpx;
  border: 2rpx solid rgba(135,155,255,0.22);
  box-shadow: inset 0 0 36rpx rgba(74,105,255,0.12), 0 0 34rpx rgba(76,104,250,0.12);
}
.wheel-ring-inner {
  width: 312rpx; height: 312rpx;
  border: 1rpx solid rgba(172,188,255,0.18);
  box-shadow: 0 0 22rpx rgba(120,145,255,0.1);
}
.wheel-spoke {
  position: absolute; top: 50%; left: 50%;
  width: 2rpx; height: 146rpx;
  transform-origin: center bottom;
  background: linear-gradient(to top, rgba(140,160,255,0.05), rgba(164,184,255,0.38), rgba(140,160,255,0.05));
  pointer-events: none;
}
.spoke-top { transform: translate(-50%, -100%); }
.spoke-upper-left { transform: translate(-50%, -100%) rotate(-45deg); }
.spoke-upper-right { transform: translate(-50%, -100%) rotate(45deg); }
.spoke-left { transform: translate(-50%, -100%) rotate(-90deg); }
.spoke-right { transform: translate(-50%, -100%) rotate(90deg); }
.spoke-lower-left { transform: translate(-50%, -100%) rotate(-135deg); }
.spoke-lower-right { transform: translate(-50%, -100%) rotate(135deg); }
.spoke-bottom { transform: translate(-50%, -100%) rotate(180deg); }
.wheel-joint {
  position: absolute;
  width: 15rpx; height: 15rpx;
  margin: -8rpx 0 0 -8rpx;
  border: 1rpx solid rgba(202,190,255,0.72);
  background: linear-gradient(135deg, #BFA7FF, #6C75FF 55%, #DCA2FF);
  box-shadow: 0 0 13rpx rgba(172,142,255,0.9);
  transform: rotate(45deg);
  z-index: 3;
  pointer-events: none;
}
.joint-top { top: calc(50% - 150rpx); left: 50%; }
.joint-upper-left { top: calc(50% - 106rpx); left: calc(50% - 106rpx); }
.joint-upper-right { top: calc(50% - 106rpx); left: calc(50% + 106rpx); }
.joint-left { top: 50%; left: calc(50% - 150rpx); }
.joint-right { top: 50%; left: calc(50% + 150rpx); }
.joint-lower-left { top: calc(50% + 106rpx); left: calc(50% - 106rpx); }
.joint-lower-right { top: calc(50% + 106rpx); left: calc(50% + 106rpx); }
.joint-bottom { top: calc(50% + 150rpx); left: 50%; }

/* 中央星球入口 · 船舵轮毂 */
.wheel-center {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  z-index: 5;
}
.center-btn {
  position: relative; display: flex; align-items: center; justify-content: center;
  width: 220rpx; height: 220rpx;
  min-width: 220rpx; min-height: 220rpx;
  max-width: 220rpx; max-height: 220rpx;
  border-radius: 50%;
  background: transparent;
  border: none;
  box-shadow:
    0 0 25rpx rgba(80,130,255,0.5),
    0 0 60rpx rgba(50,100,255,0.25);
  box-sizing: border-box;
  padding: 0; margin: 0;
  line-height: normal;
  flex-shrink: 0;
  overflow: visible;
}
.center-btn-reset {
  width: 220rpx; height: 220rpx;
  min-width: 220rpx; min-height: 220rpx;
  max-width: 220rpx; max-height: 220rpx;
  background-color: transparent;
  border: none;
  padding: 0; margin: 0;
  line-height: normal;
  flex-shrink: 0;
}
.center-btn-reset::after {
  border: none;
}
.center-btn-hover {
  opacity: 0.88;
}

/* ── 能量球主体 ── */
.center-glow {
  position: absolute; top: 0; left: 0;
  width: 100%; height: 100%;
  border-radius: 50%;
  background: radial-gradient(
    circle at 35% 30%,
    rgba(90,130,255,0.8) 0%,
    rgba(35,55,150,0.85) 45%,
    rgba(10,20,70,0.95) 100%
  );
  animation: coreBreath 3s ease-in-out infinite alternate;
  pointer-events: none;
  z-index: 1;
}
@keyframes coreBreath {
  0%   { opacity: 0.8;  transform: scale(1); }
  100% { opacity: 1;    transform: scale(1.03); }
}

/* ── 表面高光 ── */
.center-shine {
  position: absolute;
  width: 50rpx; height: 50rpx;
  top: 35rpx; left: 35rpx;
  border-radius: 50%;
  background: radial-gradient(circle,
    rgba(180,200,255,0.5) 0%,
    rgba(120,160,255,0.15) 50%,
    transparent 75%
  );
  pointer-events: none;
  z-index: 2;
}

/* ── 入口文字 ── */
.center-text {
  position: relative; z-index: 3;
  font-size: 30rpx; font-weight: 700; color: rgba(220,215,255,0.95);
  text-align: center; line-height: 1.3; letter-spacing: 4rpx;
}

/* 舵叶入口 */
.steering-leaf {
  position: absolute;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  width: 132rpx; min-height: 96rpx;
  padding: 10rpx 8rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(140,160,240,0.2);
  border-radius: 28rpx;
  background: linear-gradient(145deg, rgba(100,125,225,0.16), rgba(40,55,130,0.16));
  box-shadow: inset 0 0 18rpx rgba(145,165,255,0.08), 0 0 20rpx rgba(80,115,255,0.1);
  z-index: 4;
}
.steering-leaf:active {
  opacity: 0.76;
  box-shadow: inset 0 0 24rpx rgba(175,195,255,0.18), 0 0 30rpx rgba(105,140,255,0.24);
}
/* 恢复上一版八向位置，仅将左右功能舵叶额外向外推开 */
.leaf-top { top: 8rpx; left: 50%; transform: translateX(-50%); }
.leaf-upper-left { top: 106rpx; left: 20rpx; }
.leaf-upper-right { top: 106rpx; right: 20rpx; }
.leaf-left { top: 50%; left: -38rpx; transform: translateY(-50%); }
.leaf-right { top: 50%; right: -38rpx; transform: translateY(-50%); }
.leaf-lower-left { bottom: 110rpx; left: 20rpx; }
.leaf-lower-right { bottom: 110rpx; right: 20rpx; }
.leaf-bottom { bottom: 4rpx; left: 50%; transform: translateX(-50%); }
.leaf-disabled {
  opacity: 0.5;
  border-style: dashed;
  background: rgba(80,95,160,0.08);
}
.leaf-icon { font-size: 32rpx; line-height: 1; }
.leaf-label { font-size: 20rpx; color: rgba(230,232,255,0.72); margin-top: 7rpx; letter-spacing: 1rpx; white-space: nowrap; }

/* ── 娱乐免责声明 ── */
.home-disclaimer {
  position: fixed;
  bottom: 0;
  left: 0;
  z-index: 15;
  width: 100%;
  padding: 12rpx 40rpx calc(12rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  text-align: center;
  pointer-events: none;
}
.disclaimer-text {
  font-size: 20rpx;
  color: rgba(255,255,255,0.28);
  letter-spacing: 1rpx;
  line-height: 1.6;
}
