/** admin/reset/index.wxss **/
.admin-page { justify-content: flex-start; }

.admin-input {
  width: 440rpx; height: 80rpx;
  background: rgba(100,120,220,0.08);
  border: 1rpx solid rgba(120,150,240,0.15);
  border-radius: 16rpx;
  padding: 0 24rpx; box-sizing: border-box;
  font-size: 26rpx; color: rgba(255,255,255,0.75);
  margin: 0 auto;
}

.admin-btn-cancel {
  width: 200rpx; height: 80rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 40rpx;
  font-size: 28rpx; color: rgba(255,255,255,0.45);
  letter-spacing: 2rpx;
}

.admin-btn-confirm {
  width: 200rpx; height: 80rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(120,160,220,0.12);
  border: 1rpx solid rgba(140,180,240,0.2);
  border-radius: 40rpx;
  font-size: 28rpx; color: rgba(160,200,240,0.8);
  letter-spacing: 2rpx;
}

/* ── 结果弹窗 ── */
.result-mask {
  position: fixed; top: 0; left: 0; width: 100%; height: 100vh;
  background: rgba(3,8,26,0.8);
  display: flex; align-items: center; justify-content: center;
  z-index: 100;
}
.result-dialog {
  width: 560rpx;
  background: rgba(12,18,48,0.95);
  border: 1rpx solid rgba(140,160,240,0.15);
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  display: flex; flex-direction: column; align-items: center;
}
.result-title {
  font-size: 32rpx; font-weight: 600; color: rgba(255,255,255,0.85);
  margin-bottom: 24rpx; letter-spacing: 2rpx;
}
.result-body {
  width: 100%; margin-bottom: 28rpx;
}
.result-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12rpx 16rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}
.result-key {
  font-size: 24rpx; color: rgba(255,255,255,0.5);
}
.result-val {
  font-size: 28rpx; font-weight: 600; color: rgba(160,200,240,0.85);
}
.result-close {
  width: 240rpx; height: 80rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(100,120,220,0.12);
  border: 1rpx solid rgba(120,150,240,0.18);
  border-radius: 40rpx;
  font-size: 28rpx; color: rgba(180,190,240,0.9);
  letter-spacing: 4rpx;
}
