<!-- admin/reset/index.wxml -->
<view class="page-full admin-page" style="padding-top:{{statusBarHeight}}px;">

  <view class="universe-atmosphere">
    <view class="atmo-glow" style="top:20%;"></view>
    <view class="atmo-nebula-right" style="top:20%;right:-15%;width:60%;height:55%;background:radial-gradient(ellipse, rgba(140,120,200,0.08) 0%, transparent 70%);"></view>
    <view wx:for="{{stars}}" wx:key="i" class="atmo-star" style="top:{{item.t}};left:{{item.l}};width:{{item.w}};height:{{item.h}};--dur:{{item.d}}s;--delay:{{item.y}}s;"></view>
    <view wx:for="{{dust}}" wx:key="i" class="atmo-dust" style="top:{{item.t}};left:{{item.l}};width:{{item.w}};height:{{item.h}};--dur:{{item.d}}s;--delay:{{item.y}}s;"></view>
    <view class="atmo-meteor"></view>
    <view class="atmo-meteor-fast"></view>
  </view>

  <view class="nav-back" style="top:{{statusBarHeight}}px;" bindtap="onBack">← 返回</view>

  <view class="text-title" style="margin-top:80rpx;margin-bottom:12rpx;">🌌 宇宙重启</view>
  <view style="font-size:22rpx;color:rgba(255,255,255,0.3);margin-bottom:36rpx;letter-spacing:2rpx;">Beta 测试环境初始化工具</view>

  <view class="glass-card" style="width:560rpx;">
    <view style="font-size:26rpx;color:rgba(255,255,255,0.5);margin-bottom:28rpx;text-align:center;line-height:1.7;">该功能用于 Beta 测试环境初始化。\n\n将清除当前测试产生的数据，并恢复初始状态。</view>
    <input class="admin-input" password placeholder="请输入管理员密码" value="{{password}}" bindinput="onPasswordInput" maxlength="20" />
    <view style="display:flex;gap:20rpx;margin-top:12rpx;">
      <view class="admin-btn-cancel" bindtap="onCancel">取消</view>
      <view class="admin-btn-confirm" bindtap="onConfirm">确认重启</view>
    </view>
  </view>

  <!-- 结果弹窗 -->
  <view wx:if="{{showResult}}" class="result-mask">
    <view class="result-dialog" catchtap="">
      <view class="result-title">✅ 宇宙重启完成</view>
      <view class="result-body">
        <view wx:for="{{resultReport}}" wx:key="" wx:for-index="k" wx:for-item="v" class="result-row">
          <view class="result-key">{{k}}</view>
          <view class="result-val">{{v}}</view>
        </view>
      </view>
      <view class="result-close" bindtap="onDismissResult">好的</view>
    </view>
  </view>

</view>
