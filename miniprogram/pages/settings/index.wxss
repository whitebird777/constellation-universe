/**settings.wxss V3 **/
.settings-page { justify-content: flex-start; }

/* ── 意见反馈弹窗 ── */
.feedback-mask {
  position: fixed; top: 0; left: 0; width: 100%; height: 100vh;
  background: rgba(3,8,26,0.75);
  display: flex; align-items: center; justify-content: center;
  z-index: 100;
}
.feedback-dialog {
  width: 560rpx;
  background: rgba(12,18,48,0.95);
  border: 1rpx solid rgba(140,160,240,0.15);
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  display: flex; flex-direction: column; align-items: center;
}
.feedback-title {
  font-size: 32rpx; font-weight: 600; color: rgba(255,255,255,0.9);
  margin-bottom: 32rpx; letter-spacing: 2rpx;
}
.feedback-content {
  font-size: 26rpx; color: rgba(255,255,255,0.55);
  margin-bottom: 24rpx; text-align: center;
  white-space: pre-line; line-height: 1.7;
}
.feedback-contact-btn {
  width: 320rpx; height: 80rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(100,160,100,0.12);
  border: 1rpx solid rgba(120,200,120,0.2);
  border-radius: 40rpx;
  font-size: 28rpx; color: rgba(140,200,140,0.9);
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
  padding: 0;
}
button.feedback-contact-btn::after { border: none; }
.feedback-thanks {
  font-size: 22rpx; color: rgba(255,255,255,0.4);
  margin-bottom: 32rpx; text-align: center;
}
.feedback-close {
  width: 240rpx; height: 80rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(100,120,220,0.12);
  border: 1rpx solid rgba(120,150,240,0.18);
  border-radius: 40rpx;
  font-size: 28rpx; color: rgba(180,190,240,0.9);
  letter-spacing: 4rpx;
}

/* ── 隐私弹窗 ── */
.privacy-mask {
  position: fixed; top: 0; left: 0; width: 100%; height: 100vh;
  background: rgba(3,8,26,0.75);
  display: flex; align-items: center; justify-content: center;
  z-index: 100;
}
.privacy-dialog {
  width: 560rpx; max-height: 80vh;
  background: rgba(12,18,48,0.95);
  border: 1rpx solid rgba(140,160,240,0.15);
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  display: flex; flex-direction: column; align-items: center;
}
.privacy-title {
  font-size: 32rpx; font-weight: 600; color: rgba(255,255,255,0.9);
  margin-bottom: 28rpx; letter-spacing: 2rpx; flex-shrink: 0;
}
.privacy-scroll {
  flex: 1; min-height: 0; max-height: 50vh;
  width: 100%; margin-bottom: 28rpx;
}
.privacy-text {
  font-size: 24rpx; color: rgba(255,255,255,0.5); line-height: 1.8;
  white-space: pre-line; text-align: left;
}
.privacy-close {
  width: 240rpx; height: 80rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: rgba(100,120,220,0.12);
  border: 1rpx solid rgba(120,150,240,0.18);
  border-radius: 40rpx;
  font-size: 28rpx; color: rgba(180,190,240,0.9);
  letter-spacing: 4rpx;
}
