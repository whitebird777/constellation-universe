/**app.wxss — StarUniverse UI V2 Design System **/

/* ==========================================
   0. Reset & Base
   ========================================== */
button { background: initial; }
button:focus { outline: 0; }
button::after { border: none; }

page {
  background: radial-gradient(ellipse at 50% 30%, #0E1648 0%, #090F35 40%, #03081A 100%);
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  overflow: hidden;
}

/* ==========================================
   1. Atmosphere — 动态宇宙背景层
   ========================================== */
.universe-atmosphere {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100vh;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

/* 1a. Central Glow — 页面中心光晕 */
.atmo-glow {
  position: absolute;
  top: 15%; left: 50%;
  transform: translateX(-50%);
  width: 500rpx; height: 500rpx;
  background: radial-gradient(circle, rgba(100,120,220,0.12) 0%, rgba(80,100,200,0.05) 40%, transparent 70%);
  border-radius: 50%;
  animation: glowBreath 6s ease-in-out infinite alternate;
}
@keyframes glowBreath {
  0%   { opacity: 0.6; transform: translateX(-50%) scale(0.9); }
  100% { opacity: 1;   transform: translateX(-50%) scale(1.1); }
}

/* 1b. Nebula — CSS 星云层 */
.atmo-nebula-left {
  position: absolute;
  top: 10%; left: -35%;
  width: 90%; height: 70%;
  background: radial-gradient(ellipse, rgba(100,80,200,0.10) 0%, transparent 65%);
  animation: nebulaDrift 20s ease-in-out infinite alternate;
}
.atmo-nebula-right {
  position: absolute;
  top: 35%; right: -30%;
  width: 80%; height: 60%;
  background: radial-gradient(ellipse, rgba(60,100,180,0.08) 0%, transparent 65%);
  animation: nebulaDrift 25s ease-in-out infinite alternate-reverse;
}
@keyframes nebulaDrift {
  0%   { transform: translate(0, 0); }
  100% { transform: translate(30rpx, -20rpx); }
}

/* 1c. Stars — 独立星点 */
.atmo-star {
  position: absolute;
  border-radius: 50%;
  background: #fff;
  animation: starPulse var(--dur) ease-in-out infinite alternate;
  animation-delay: var(--delay);
}
@keyframes starPulse {
  0%   { opacity: 0.15; transform: scale(0.6); }
  50%  { opacity: 1;    transform: scale(1.3); }
  100% { opacity: 0.3;  transform: scale(0.8); }
}

/* 1d. Stardust — 漂浮粒子 */
.atmo-dust {
  position: absolute;
  border-radius: 50%;
  background: rgba(180,200,255,0.4);
  animation: dustFloat var(--dur) ease-in-out infinite;
  animation-delay: var(--delay);
}
@keyframes dustFloat {
  0%   { opacity: 0;   transform: translateY(0) translateX(0); }
  25%  { opacity: 0.6; transform: translateY(-30rpx) translateX(15rpx); }
  50%  { opacity: 0.2; transform: translateY(-60rpx) translateX(-10rpx); }
  75%  { opacity: 0.5; transform: translateY(-30rpx) translateX(-20rpx); }
  100% { opacity: 0;   transform: translateY(0) translateX(0); }
}

/* 1e. Meteor System — 双流星 */
.atmo-meteor {
  position: absolute;
  top: -4rpx; left: 60%;
  width: 2rpx; height: 100rpx;
  background: linear-gradient(180deg, rgba(180,200,255,0.9), rgba(180,200,255,0));
  border-radius: 1rpx;
  opacity: 0;
  animation: meteorA 18s ease-in infinite;
  animation-delay: 3s;
}
.atmo-meteor-fast {
  position: absolute;
  top: -4rpx; left: 80%;
  width: 2rpx; height: 70rpx;
  background: linear-gradient(180deg, rgba(200,220,255,0.85), rgba(200,220,255,0));
  border-radius: 1rpx;
  opacity: 0;
  animation: meteorB 12s ease-in infinite;
  animation-delay: 8s;
}
@keyframes meteorA {
  0%   { opacity: 0; top: -100rpx; left: 75%; transform: rotate(-40deg); }
  3%   { opacity: 1; }
  6%   { opacity: 0; top: 400rpx; left: 10%; transform: rotate(-40deg); }
  100% { opacity: 0; top: 400rpx; left: 10%; }
}
@keyframes meteorB {
  0%   { opacity: 0; top: -80rpx; left: 85%; transform: rotate(-30deg); }
  4%   { opacity: 1; }
  8%   { opacity: 0; top: 350rpx; left: 20%; transform: rotate(-30deg); }
  100% { opacity: 0; top: 350rpx; left: 20%; }
}

/* ==========================================
   2. Hero Visuals — 星球系统
   ========================================== */
.hero-planet {
  width: 200rpx; height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #6B9EF5 0%, #3D6FD5 30%, #1A4AAA 60%, #0E2D78 85%, #051840 100%);
  box-shadow:
    0 0 80rpx rgba(80,140,240,0.35),
    0 0 180rpx rgba(60,100,200,0.15),
    inset -20rpx -10rpx 40rpx rgba(0,0,0,0.5);
  animation: planetFloat 8s ease-in-out infinite;
}
@keyframes planetFloat {
  0%   { transform: translateY(0) rotate(0deg); }
  50%  { transform: translateY(-16rpx) rotate(3deg); }
  100% { transform: translateY(0) rotate(0deg); }
}

.hero-glow-ring {
  width: 260rpx; height: 260rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(120,160,230,0.12);
  box-shadow: 0 0 60rpx rgba(100,140,220,0.08);
  animation: ringPulse 5s ease-in-out infinite alternate;
}
@keyframes ringPulse {
  0%   { opacity: 0.5; transform: scale(0.95); }
  100% { opacity: 1;   transform: scale(1.05); }
}

/* Small planet variant for planet page */
.hero-planet-sm {
  width: 160rpx; height: 160rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #6B9EF5 0%, #3D6FD5 30%, #1A4AAA 60%, #0E2D78 85%, #051840 100%);
  box-shadow: 0 0 60rpx rgba(80,140,240,0.3), 0 0 120rpx rgba(60,100,200,0.1);
  animation: planetFloat 7s ease-in-out infinite;
}

/* ==========================================
   3. Glass Card System
   ========================================== */
.glass-card {
  background: rgba(255,255,255,0.035);
  border: 1rpx solid rgba(255,255,255,0.07);
  border-radius: 24rpx;
  box-shadow:
    0 8rpx 32rpx rgba(0,0,0,0.25),
    inset 0 1rpx 0 rgba(255,255,255,0.04);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  padding: 32rpx;
}

/* ==========================================
   4. Button System
   ========================================== */
.btn-primary {
  display: flex; align-items: center; justify-content: center;
  width: 560rpx; height: 100rpx;
  background: linear-gradient(135deg, #5B6EF5 0%, #7C5CF0 40%, #A855F7 100%);
  color: #fff; font-size: 30rpx; font-weight: 600;
  border-radius: 50rpx; border: none;
  box-shadow: 0 8rpx 32rpx rgba(100,70,220,0.4), 0 0 60rpx rgba(120,90,240,0.15);
  transition: transform 0.12s ease, box-shadow 0.12s ease;
  position: relative;
  overflow: hidden;
}
.btn-primary:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx rgba(100,70,220,0.3);
}

.btn-secondary {
  display: flex; align-items: center; justify-content: center;
  width: 560rpx; height: 100rpx;
  background: rgba(255,255,255,0.05);
  color: rgba(255,255,255,0.6); font-size: 28rpx; font-weight: 500;
  border-radius: 50rpx; border: 1rpx solid rgba(255,255,255,0.06);
}
.btn-secondary:active { background: rgba(255,255,255,0.08); }

.btn-disabled {
  background: rgba(255,255,255,0.03);
  color: rgba(255,255,255,0.18);
  border: 1rpx solid rgba(255,255,255,0.03);
  box-shadow: none;
}

.btn-danger {
  display: flex; align-items: center; justify-content: center;
  width: 560rpx; height: 100rpx;
  background: transparent; color: #E56060; font-size: 28rpx; font-weight: 500;
  border-radius: 50rpx;
  border: 1rpx solid rgba(229,96,96,0.3);
  box-shadow: 0 0 24rpx rgba(229,96,96,0.1);
}
.btn-danger:active { background: rgba(229,96,96,0.08); }

/* ==========================================
   5. Typography
   ========================================== */
.text-hero    { font-size: 56rpx; font-weight: 700; color: #fff; letter-spacing: 6rpx; line-height: 1.3; }
.text-title   { font-size: 44rpx; font-weight: 600; color: #fff; letter-spacing: 4rpx; line-height: 1.4; }
.text-subtitle { font-size: 28rpx; color: rgba(255,255,255,0.55); letter-spacing: 2rpx; }
.text-body    { font-size: 26rpx; color: rgba(255,255,255,0.45); line-height: 1.8; text-align: center; }
.text-label   { font-size: 20rpx; color: rgba(255,255,255,0.3); letter-spacing: 3rpx; }

/* ==========================================
   6. Navigation
   ========================================== */
.nav-back {
  position: absolute; top: 0; left: 0;
  padding: 24rpx 32rpx;
  font-size: 24rpx; color: rgba(255,255,255,0.35);
  z-index: 10; letter-spacing: 2rpx;
}

/* ==========================================
   7. Layout Helpers
   ========================================== */
.page-full {
  display: flex; flex-direction: column; align-items: center;
  height: 100vh; padding: 0 40rpx; box-sizing: border-box;
  position: relative; z-index: 1;
}
.page-scroll {
  display: flex; flex-direction: column; align-items: center;
  min-height: 100vh; padding: 0 40rpx; box-sizing: border-box;
  position: relative; z-index: 1;
}
